        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Draw Particle
if(control==ns_get_player_id(obj_network.tcp_handle))
{
    effect_create_below(ef_smoke, x, y, 0, $80FF80)
}
else
{
    effect_create_below(ef_smoke, x, y, 0, $8080FF)
}
</string>
          </argument>
        </arguments>

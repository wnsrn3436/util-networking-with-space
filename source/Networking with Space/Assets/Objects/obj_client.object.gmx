        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Go Inside The Screen
if(control==ns_get_player_id(obj_network.tcp_handle))
{
    x = clamp(x, x-bbox_left, room_width+(x-bbox_right))
    y = clamp(y, y-bbox_top, room_height+(y-bbox_bottom))
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///X, Y Send
if(control==ns_get_player_id(obj_network.tcp_handle))
{
    
    x += 3*(keyboard_check(vk_right)-keyboard_check(vk_left))
    y += 3*(keyboard_check(vk_down)-keyboard_check(vk_up))
    
    buffer_seek(NsSendBuffer, buffer_seek_start, 0)
    buffer_write(NsSendBuffer, buffer_u16, x)
    buffer_write(NsSendBuffer, buffer_u16, y)
    ns_message_send(obj_network.tcp_handle, ToMySpace, SendToAll, NS.CLIENT_POSITION)
    
}
</string>
          </argument>
        </arguments>
      </action>
    </event>

        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Server Condition Check
if(ns_get_is_disconnected(tcp_handle))
{
    show_message("The connection to the server has been lost.")
    game_end()
}
alarm[0] = room_speed
</string>
          </argument>
        </arguments>
      </action>
    </event>

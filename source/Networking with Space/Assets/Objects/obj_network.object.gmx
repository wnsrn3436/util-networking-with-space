        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Client Event
switch(NsMsgType)
{
    case TypeConnected:
        alarm[1] = 1 //Get ping
        break
        
    case TypeConnectionFailed:
        show_message("The personnel of the server is full(or version error).")
        game_end()
        break
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="10">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Message Event
switch(NsMsgId)
{
    case NS.NEW_CLIENT_CREATE:
        var sent_player = buffer_read(NsRecvBuffer, buffer_u16), ins;
        ins = instance_create(10, 10, obj_client)
        ins.control = sent_player
        if(ns_get_player_id(NsMsgRecvHandle)!=sent_player)
        {
            buffer_seek(NsSendBuffer, buffer_seek_start, 0)
            ns_message_send(NsMsgRecvHandle, ToMySpace, sent_player, NS.OLD_CLIENT_CREATE)
        }
        break
        
    case NS.OLD_CLIENT_CREATE:
        var ins = instance_create(10, 10, obj_client);
        ins.control = NsMsgSentPlayer
        break
        
    case NS.CLIENT_DESTROY:
        var sent_player = buffer_read(NsRecvBuffer, buffer_u16);
        with(obj_client)
        {
            if(control==sent_player)
            {
                instance_destroy()
                break
            }
        }
        break
        
    case NS.CLIENT_POSITION:
        with(obj_client)
        {
            if(control==NsMsgSentPlayer)
            {
                x = buffer_read(NsRecvBuffer, buffer_u16)
                y = buffer_read(NsRecvBuffer, buffer_u16)
                break
            }
        }
        break
        
    case NS.PING:
        ping = current_time-buffer_read(NsRecvBuffer, buffer_u32)
        break
}
</string>
          </argument>
        </arguments>
      </action>
    </event>

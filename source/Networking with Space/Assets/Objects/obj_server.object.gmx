    <event eventtype="7" enumb="11">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Server Event
switch(NsMsgType)
{
    case TypeClientConnected:
        /*
            In this case, 
            1. the NsMsgSentPlayer is playerid of new player
            2. the NsMsgSentSpace(or NsMsgId) is joinspace of new player
            3. You can read the NsRecvBuffer
        */
        buffer_seek(NsSendBuffer, buffer_seek_start, 0)
        buffer_write(NsSendBuffer, buffer_u16, NsMsgSentPlayer)
        ns_message_send(NsMsgRecvHandle, NsMsgSentSpace, SendToAll, NS.NEW_CLIENT_CREATE)
        break
        
    case TypeClientDisconnected:
        /*
            In this case, 
            1. the NsMsgSentPlayer is playerid of exit player
            2. the NsMsgSentSpace(or NsMsgId) is joinspace of exit player
        */
        buffer_seek(NsSendBuffer, buffer_seek_start, 0)
        buffer_write(NsSendBuffer, buffer_u16, NsMsgSentPlayer)
        ns_message_send(NsMsgRecvHandle, NsMsgSentSpace, SendToAll, NS.CLIENT_DESTROY)
        break
        
    case TypeClientSpaceChanged:
        /*
            In this case, 
            1. the NsMsgSentPlayer is playerid of this player
            2. the NsMsgSentSpace is previous joinspace of this player
            3. the NsMsgId is new joinspace of this player
            4. You can read the NsRecvBuffer
        */
        ns_message_trigger(NsMsgRecvHandle, NsEventServer, TypeClientDisconnected, NsMsgSentSpace, NsMsgSentPlayer, NsMsgSentSpace, noone)
        ns_message_trigger(NsMsgRecvHandle, NsEventServer, TypeClientConnected, NsMsgId, NsMsgSentPlayer, NsMsgId, NsRecvBuffer)
        break
        
    case TypeServerCreated:
        //In this case, please refer to TypeClientConnected
        break
        
    case TypeServerSpaceChanged:
        //In this case, please refer to TypeClientSpaceChanged
        break
        
    case TypeServerWasAttacked:
        show_debug_message("NS::"+"Server handle("+string(NsMsgRecvHandle)+") has been attacked by client("+string(NsMsgSentPlayer)+") --- "+string(NsMsgSentIP)+"|"+string(NsMsgSentPort))
        break
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="10">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Message Event
switch(NsMsgId)
{
    case NS.PING:
        buffer_seek(NsSendBuffer, buffer_seek_start, 0)
        buffer_write(NsSendBuffer, buffer_u32, buffer_read(NsRecvBuffer, buffer_u32))
        ns_message_send(NsMsgRecvHandle, ToEverySpace, NsMsgSentPlayer, NS.PING)
        break
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
